# ─── Supabase ────────────────────────────────────────────────────────────────
# Get all three from: Supabase dashboard → Settings → API
# Local dev: use the values printed by `supabase start`
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# WARNING: bypasses RLS — server-side only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# ─── Anthropic ───────────────────────────────────────────────────────────────
# https://console.anthropic.com → API Keys
# Used by all Claude Sonnet 4.6 agent calls in lib/agents/
ANTHROPIC_API_KEY=

# ─── OpenAI (embeddings) ─────────────────────────────────────────────────────
# https://platform.openai.com/api-keys
# Used exclusively for text-embedding-3-small in the RAG pipeline
OPENAI_API_KEY=

# ─── Google Maps ─────────────────────────────────────────────────────────────
# https://console.cloud.google.com → APIs & Services → Credentials
# Enable both "Maps JavaScript API" and "Places API (New)" (not the legacy Places API)
# This key is NEXT_PUBLIC_ because the Maps JS SDK loads in the browser.
# Restrict it to HTTP referrers in production.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ─── Resend (email) ──────────────────────────────────────────────────────────
# https://resend.com/api-keys
# Used for transactional email (password reset, account confirmation)
RESEND_API_KEY=

# ─── NewsAPI ─────────────────────────────────────────────────────────────────
# https://newsapi.org/account  (free tier: 100 req/day)
# Proxied through /api/news — never exposed to the browser
NEWS_API_KEY=

# ─── SerpAPI ─────────────────────────────────────────────────────────────────
# https://serpapi.com/manage-api-key  (free tier: 100 req/month)
# Proxied through /api/events — never exposed to the browser
SERPAPI_KEY=

# ─── App ─────────────────────────────────────────────────────────────────────
# Full URL including protocol — used for OAuth redirects and email links
# Local: http://localhost:3000 | Preview: https://<deployment>.vercel.app | Production: your domain
NEXT_PUBLIC_APP_URL=http://localhost:3000
